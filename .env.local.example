# Core Contentful
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENV_ID=
CONTENTFUL_DELIVERY_KEY=
CONTENTFUL_PREVIEW_KEY=
CONTENTFUL_MANAGEMENT_KEY=
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_REVALIDATION_SECRET=

# Contentful Personalization
CONTENTFUL_OPTIMIZATION_CLIENT=
CONTENTFUL_OPTIMIZATION_ENV_ID=

# Renders the track/identify demo buttons on published pages. Off by default so a
# plain render stays markup-identical to the Next.js version this was ported from.
CONTENTFUL_OPTIMIZATION_DEMO_CONTROLS=

# Consent is read from the `cmp-consent` cookie, which a third-party CMP would own
# (see src/lib/consent.ts). There is no env var for it — with the demo controls on,
# the Grant/Deny/Unset buttons flip that cookie for you.
