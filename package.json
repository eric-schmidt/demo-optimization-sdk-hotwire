{
  "name": "demo-live-preview-hotwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:assets && tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "npm run build:assets && tsx --env-file-if-exists=.env.local src/server.ts",
    "build": "npm run build:assets && npm run typecheck",
    "build:assets": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i src/styles/globals.css -o public/assets/app.css",
    "build:js": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.tsx"
  },
  "dependencies": {
    "@contentful/live-preview": "^4.6.42",
    "@contentful/optimization-node": "^1.2.1",
    "@contentful/optimization-web": "^1.3.0",
    "@contentful/optimization-web-preview-panel": "^1.2.0",
    "@contentful/timeline-preview": "^1.1.1",
    "@hono/node-server": "^1.13.8",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.13",
    "chalk": "^5.6.2",
    "contentful": "^11.9.0",
    "hono": "^4.7.11",
    "safe-json-stringify": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@types/node": "^22.13.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
